# ============================================
# 校园综合服务平台 — 环境变量配置
# ============================================

# ─── MySQL ───
MYSQL_ROOT_PASSWORD=20041015
MYSQL_CHARSET=utf8mb4

# ─── Redis ───
REDIS_PORT=6379

# ─── Nacos ───
NACOS_PORT=8848
NACOS_AUTH_ENABLE=false

# ─── RabbitMQ ───
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

# ─── Sentinel Dashboard ───
SENTINEL_PORT=8081

# ─── 各服务端口 ───
GATEWAY_PORT=8080
USER_SERVICE_PORT=8082
NEWS_SERVICE_PORT=8083
FORUM_SERVICE_PORT=8084
LOSTFOUND_SERVICE_PORT=8085
SECONDHAND_SERVICE_PORT=8086
COMPLAINT_SERVICE_PORT=8087
